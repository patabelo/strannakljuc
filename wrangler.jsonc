{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name already registered in the Cloudflare
  // dashboard ("strannakljuc"), or Workers Builds will fail to deploy.
  "name": "strannakljuc",
  "compatibility_date": "2026-08-25",
  // Pure static site (Next.js `output: "export"`) — no Worker script
  // needed. The contact form opens a pre-filled mailto:/Gmail link
  // directly from the visitor's own browser, so no backend or paid
  // Cloudflare Email Sending plan is required.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
