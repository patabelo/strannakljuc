{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name already registered in the Cloudflare
  // dashboard ("strannakljuc"), or Workers Builds will fail to deploy.
  "name": "strannakljuc",
  "compatibility_date": "2026-08-25",
  // Static site plus one contact endpoint. The form posts here;
  // the Worker emails patrick@strannakljuc.si. Everything else is a file.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    { "name": "EMAIL" }
  ],
  "observability": {
    "enabled": true
  }
}
