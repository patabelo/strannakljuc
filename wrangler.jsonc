{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name already registered in the Cloudflare
  // dashboard ("strannakljuc"), or Workers Builds will fail to deploy.
  "name": "strannakljuc",
  "compatibility_date": "2026-08-27",
  // Worker script handles POST /api/contact (e-pošta prek Resend API);
  // vse ostalo postrežejo statični viri (Next.js `output: "export"`).
  "main": "worker/index.ts",
  "secrets": {
    "required": ["RESEND_API_KEY"]
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/zasebnost*",
      "/primeri*",
      "/api/*",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  "observability": {
    "enabled": true
  }
}
